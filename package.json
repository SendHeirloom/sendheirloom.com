{
  "scripts": {
    "start": "npm-run-all --parallel css-style css-tailwind eleventy",
    "eleventy": "eleventy --serve",
    "debug": "set DEBUG=* & eleventy",
    "css-style": "postcss src/static/css/style.css --o _tmp/static/css/style.css --watch",
    "css-tailwind": "postcss src/static/css/tailwind.css --o _tmp/static/css/tailwind.css --watch",
    "build": "cross-env NODE_ENV=production eleventy && cross-env NODE_ENV=production postcss src/static/css/style.css --o _site/static/css/style.css && cross-env NODE_ENV=production postcss src/static/css/tailwind.css --o _site/static/css/tailwind.css"
  },
  "devDependencies": {
    "@11ty/eleventy": "^1.0.1",
    "@11ty/eleventy-img": "^2.0.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "^3.0.1",
    "alpinejs": "^2.6.0",
    "cross-env": "^7.0.2",
    "cssnano": "^4.1.10",
    "html-minifier": "^4.0.0",
    "js-yaml": "^3.14.0",
    "luxon": "^1.25.0",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^8.3.1"
  },
  "dependencies": {
    "@11ty/eleventy-plugin-rss": "^1.1.0",
    "@tailwindcss/typography": "^0.5.2",
    "autoprefixer": "^10.2.6",
    "jquery": "^3.6.0",
    "owl.carousel": "^2.3.4",
    "postcss": "^8.4.14",
    "postcss-import": "^14.0.0",
    "posthog-js": "^1.327.0",
    "shopify-buy": "^2.13.0",
    "tailwindcss": "^3"
  }
}
